# Copy to .env and adjust. Every setting maps to ragdesk/core/config.py (case-insensitive).

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]

# Infrastructure (host ports of `docker compose up -d postgres redis`)
DATABASE_URL=postgresql+asyncpg://ragdesk:ragdesk@localhost:5435/ragdesk
REDIS_URL=redis://localhost:6381/0

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me

# Providers: "fake" runs offline and deterministically (no API keys needed)
EMBEDDER=fake
CHAT_MODEL_PROVIDER=fake
# EMBEDDER=gemini
# GEMINI_API_KEY=...            # https://aistudio.google.com/apikey
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# CHAT_MODEL_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Retrieval
# RETRIEVAL_TOP_K=6
# RETRIEVAL_MAX_DISTANCE=0.55

# Rate limits (requests per minute per client IP)
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_CHAT_PER_MINUTE=20
# RATE_LIMIT_UPLOAD_PER_MINUTE=20

# Ingestion: allow localhost/private URL targets only for local testing
# URL_ALLOW_PRIVATE_HOSTS=true
# MAX_UPLOAD_MB=20
# MAX_SOURCES_PER_BOT=50
